# =====================================================================
# VoiceStock AI — Backend environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# =====================================================================

# --- Security ---
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./data/voicestock.db

# --- CORS (comma separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI: NLU provider (Gemini). Leave GEMINI_API_KEY empty to force rule-based fallback. ---
NLU_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- AI: Speech-to-text (Whisper). Leave WHISPER_MODEL empty to disable Real Mode STT. ---
# Backends: "faster-whisper" (recommended) or "openai-whisper".
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Audio upload limits ---
MAX_AUDIO_MB=15

# --- App mode default: "simulation" or "real" ---
DEFAULT_MODE=simulation
